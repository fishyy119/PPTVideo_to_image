{
    "editor.formatOnSave": true,
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    "C_Cpp.clang_format_style": "file",
    "C_Cpp.errorSquiggles": "enabled",
    "files.associations": {
        "*.sdf": "xml",
        "*.msg": "ros2.interface",
        "*.srv": "ros2.interface",
        "*.toml": "toml",
        "format": "cpp"
    }
}